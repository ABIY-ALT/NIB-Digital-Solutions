# ─────────────────────────────────────────────────────────────────────────────
# Frontend settings for the Windows server (no Docker).
# Guide: deploy/windows/README.md
#
#   1. Copy to frontend\.env.production on the server (never commit the copy).
#   2. Run  node deploy\windows\fill-secrets.mjs  from the project folder: it
#      writes fresh secrets over every __GENERATE__ here and in backend\.env,
#      with the shared values matching.
#
# Build after this file is filled: `npm run build` reads it too.
# All values are server-side only.
# ─────────────────────────────────────────────────────────────────────────────

# Where this server listens. IIS forwards https://<site> to it (web.config).
PORT=3030
HOSTNAME=127.0.0.1

# The backend, on the same machine.
BACKEND_URL=http://127.0.0.1:4000
BACKEND_API_PREFIX=/api/v1
BACKEND_TIMEOUT_MS=15000

# Must match the backend's SERVICE_CLIENTS=digitalproducts-web:<secret>
BACKEND_SERVICE_CLIENT_ID=digitalproducts-web
BACKEND_SERVICE_CLIENT_SECRET=__GENERATE__

# Must match the backend's PAYLOAD_ENCRYPTION_KEYS
PAYLOAD_ENCRYPTION_ENABLED=true
PAYLOAD_ENCRYPTION_KEYS=k1:__GENERATE__
PAYLOAD_ENCRYPTION_ACTIVE_KEY_ID=k1

# Sign-in. AUTH_URL is the browser-facing HTTPS address, no trailing slash:
# the session cookie is Secure, so sign-in does not work over plain HTTP.
AUTH_SECRET=__GENERATE__
AUTH_URL=https://digitalproductstest.nibbank.com.et
AUTH_TRUST_HOST=true
CSRF_SECRET=__GENERATE__

# Optional single sign-on. Leave empty to hide the SSO button.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_NAME=NIB SSO
AUTH_OIDC_BACKEND_PROVIDER=oidc

LOG_LEVEL=info
LOG_PRETTY=false

# Public address used in canonical links, sitemap.xml and robots.txt.
SITE_URL=https://digitalproductstest.nibbank.com.et
