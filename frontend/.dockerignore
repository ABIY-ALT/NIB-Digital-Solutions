# Keep the build context small and free of secrets.

# Secrets — never copied into an image.
.env
.env.*

# Dependencies and build output (rebuilt inside the image).
node_modules
.next
out
build
dist
.turbo
*.tsbuildinfo
next-env.d.ts

# Version control and CI.
.git
.gitignore
.gitlab-ci.yml

# Editor / OS noise.
.idea
.vscode
.DS_Store
Thumbs.db

# Test coverage output.
coverage

# Logs and temp files.
logs
*.log
npm-debug.log*
.cache

# Docker + tooling files not needed at build time.
Dockerfile
.dockerignore
