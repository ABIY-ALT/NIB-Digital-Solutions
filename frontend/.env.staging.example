# ─────────────────────────────────────────────────────────────────────────────
# Template for frontend/.env.staging — copy it and fill in real values.
#
# Used by docker-compose.staging.yml on the staging host (next to the compose
# file, never committed). All values are SERVER-SIDE ONLY.
#
# BACKEND_URL is set by docker-compose.staging.yml (http://backend:4000).
#
# Secrets: generate fresh ones for staging with `cd backend && npm run
# keys:generate`. BACKEND_SERVICE_CLIENT_SECRET and PAYLOAD_ENCRYPTION_KEYS
# must match backend/.env.staging exactly.
# ─────────────────────────────────────────────────────────────────────────────

BACKEND_API_PREFIX=/api/v1
BACKEND_TIMEOUT_MS=15000

# BFF service identity — must match backend SERVICE_CLIENTS=appcore-web:<secret>
BACKEND_SERVICE_CLIENT_ID=appcore-web
BACKEND_SERVICE_CLIENT_SECRET=__GENERATE__

# Payload encryption BFF ⇄ backend — keys must match the backend
PAYLOAD_ENCRYPTION_ENABLED=true
PAYLOAD_ENCRYPTION_KEYS=k1:__GENERATE__
PAYLOAD_ENCRYPTION_ACTIVE_KEY_ID=k1

# Auth.js (encrypts the session cookie) and CSRF token signing.
# AUTH_URL is the browser-facing HTTPS address: in production the session
# cookie is __Host- and Secure, so sign-in does not work over plain HTTP.
AUTH_SECRET=__GENERATE__
AUTH_URL=https://CHANGE_ME
AUTH_TRUST_HOST=true
CSRF_SECRET=__GENERATE__

# Optional OIDC identity provider. Leave empty to hide the SSO button.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_NAME=NIB SSO
AUTH_OIDC_BACKEND_PROVIDER=oidc

# Logging. pino-pretty is not in the image: keep LOG_PRETTY false.
LOG_LEVEL=info
LOG_PRETTY=false

# Public address of the NIB Digital Solutions website (canonical links, sitemap.xml,
# robots.txt). Empty: AUTH_URL is used.
SITE_URL=https://CHANGE_ME
