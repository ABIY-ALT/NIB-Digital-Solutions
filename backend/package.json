{
  "name": "@appcore/backend",
  "version": "0.1.0",
  "description": "AppCore backend framework (NestJS, Clean Architecture)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#bootstrap/*": {
      "types": "./src/bootstrap/*",
      "development": "./src/bootstrap/*",
      "default": "./dist/bootstrap/*"
    },
    "#config/*": {
      "types": "./src/config/*",
      "development": "./src/config/*",
      "default": "./dist/config/*"
    },
    "#core/*": {
      "types": "./src/core/*",
      "development": "./src/core/*",
      "default": "./dist/core/*"
    },
    "#generated/*": {
      "types": "./src/generated/*",
      "development": "./src/generated/*",
      "default": "./dist/generated/*"
    },
    "#modules/*": {
      "types": "./src/modules/*",
      "development": "./src/modules/*",
      "default": "./dist/modules/*"
    }
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,prisma}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:cov": "vitest run --config vitest.e2e.config.ts --coverage",
    "check": "npm run typecheck && npm run lint && npm test && npm run contract:check",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:setup": "node scripts/db-setup.js .env",
    "db:setup:staging": "node scripts/db-setup.js .env.staging",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "cli": "node scripts/cli.mjs",
    "keys:generate": "node scripts/generate-secrets.mjs",
    "contract:export": "nest build && node dist/openapi-export.js",
    "contract:check": "nest build && node dist/openapi-export.js --check",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@swc/core": "^1.16.12",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4",
    "vite": "^8.3.4",
    "multer": "^2.5.0"
  }
}
