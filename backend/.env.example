# ─────────────────────────────────────────────────────────────────────────────
# AppCore backend — environment template
# Copy to .env and fill in. Generate secrets with:  npm run keys:generate
# The app validates this file at startup and refuses to start if it is invalid.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_NAME=appcore-backend
PORT=4000
API_PREFIX=api
API_DEFAULT_VERSION=1
TRUST_PROXY=loopback
BODY_LIMIT=1mb

# ── E-mail ───────────────────────────────────────────────────────────────────
# log  → e-mails are written to the log (development; links can be copied from it)
# smtp → e-mails are sent through SMTP_HOST
PUBLIC_APP_URL=http://localhost:3000
MAIL_FROM=NIB Digital Solutions <no-reply@nib.et>
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (465); false = STARTTLS (587)
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# false only for an internal relay whose certificate comes from a private CA
SMTP_TLS_REJECT_UNAUTHORIZED=true

LOG_LEVEL=info
LOG_PRETTY=true
# stdout | stderr. The CLI (npm run cli) always logs to stderr so stdout carries only its output.
LOG_STREAM=stdout

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Password "User@123456" — the "@" is URL-encoded as %40.
DATABASE_URL=postgresql://postgres:User%40123456@localhost:5432/appcore?schema=public
DATABASE_POOL_MAX=10

# ── Key/value store: sessions, cache, idempotency, rate limits, MFA ─────────
# redis  → production (REDIS_URL required)
# memory → local development without Redis (single process, not durable)
KV_STORE=memory
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=appcore:

# ── Tokens & sessions ────────────────────────────────────────────────────────
JWT_ISSUER=appcore-backend
JWT_AUDIENCE=appcore-bff
JWT_ACCESS_SECRET=__GENERATE__base64_48_bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
REFRESH_REUSE_GRACE_SECONDS=15
SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Self-service "forgot password" (e-mailed single-use link)
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_MINUTES=2

# ── MFA ──────────────────────────────────────────────────────────────────────
MFA_ISSUER=NIB Digital Solutions
MFA_CHALLENGE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5
MFA_SECRET_ENCRYPTION_KEY=__GENERATE__base64_32_bytes

# ── External OIDC identity provider (optional) ──────────────────────────────
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_AUTO_PROVISION=false

# ── BFF service identity (must match the frontend) ──────────────────────────
CORS_ORIGINS=http://localhost:3000
SERVICE_AUTH_ENABLED=true
SERVICE_CLIENTS=appcore-web:__GENERATE__shared_secret
SERVICE_AUTH_MAX_SKEW_SECONDS=300

# ── Payload encryption BFF ⇄ backend (keys must match the frontend) ─────────
# disabled | optional | required
PAYLOAD_ENCRYPTION_MODE=optional
PAYLOAD_ENCRYPTION_KEYS=k1:__GENERATE__base64_32_bytes
PAYLOAD_ENCRYPTION_ACTIVE_KEY_ID=k1

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=10

# ── Caching & idempotency ────────────────────────────────────────────────────
CACHE_DEFAULT_TTL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400

# ── API documentation ────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ── Integrations ─────────────────────────────────────────────────────────────
CORE_BANKING_ADAPTER=mock
CORE_BANKING_BASE_URL=
CORE_BANKING_API_KEY=
CORE_BANKING_TIMEOUT_MS=10000

# ── Product links ────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
MAIL_FROM=NIB Digital Solutions <no-reply@nib.et>

# ── Account security policy ──────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true
# Previous passwords that cannot be reused
PASSWORD_HISTORY_COUNT=5
# 0 = passwords never expire
PASSWORD_MAX_AGE_DAYS=90
# 0 = can be changed again immediately
PASSWORD_MIN_AGE_HOURS=0
PASSWORD_EXPIRY_WARNING_DAYS=14
# Passwords set by an administrator (new users, resets) must be changed at first sign-in
PASSWORD_CHANGE_ON_FIRST_LOGIN=true
# 0 = unlimited; the least recently used session ends when exceeded
SESSION_MAX_CONCURRENT=3
# Comma-separated roles that must use two-step verification (users are reminded)
MFA_REQUIRED_ROLES=
NEW_DEVICE_ALERTS=true

# ── Maker–checker approvals ──────────────────────────────────────────────────
APPROVALS_ENABLED=true
# Actions that need a second person's approval ("none" = off). Available:
#   roles.create, roles.update, roles.delete, users.update, users.delete,
#   reference-data.items.create, reference-data.items.update, reference-data.items.delete,
#   digital-products.create|update|delete, product-categories.create|update|delete,
#   demo-requests.create|update|delete, product-inquiries.create|update|delete
APPROVAL_ACTIONS=roles.create,roles.update,roles.delete,users.delete
APPROVAL_EXPIRY_HOURS=72

# ── Tamper-evident audit & data retention ────────────────────────────────────
# HMAC key of the audit hash chain (base64, 32 bytes). Required in production;
# never rotate it without an anchor checkpoint (see README).
AUDIT_CHAIN_KEY=
AUDIT_RETENTION_DAYS=2555
NOTIFICATION_RETENTION_DAYS=180
APPROVAL_RETENTION_DAYS=730
RETENTION_ENABLED=true
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=500
ARCHIVE_DIR=storage/archive
# Background jobs (retention, approval expiry, audit anchors, reminders)
JOBS_ENABLED=true

# ── NIB Digital Solutions marketplace ────────────────────────────────────────
# Claude API key for the grounded product assistant (server side only).
# Empty: the website answers with its on-device catalog assistant instead.
ANTHROPIC_API_KEY=
MARKETPLACE_ASSISTANT_MODEL=claude-opus-5-5
# Largest uploaded product image in bytes (PNG, JPEG, WebP, AVIF; checked from
# the file's bytes). Keep below BODY_LIMIT after base64 encoding (about x1.37).
MARKETPLACE_MEDIA_MAX_BYTES=700000
# Secret for hashing visitor IPs / voter tokens (ideas board, product questions). Set in production.
MARKETPLACE_PRIVACY_SALT=

# ── Telegram bot: developer notifications and replies ──────────────────────
# Create a bot with @BotFather. The token stays on the server (never in the frontend).
# TELEGRAM_MODE: off (questions are e-mailed to developers) | polling (development)
#                | webhook (production: Telegram posts to PUBLIC_APP_URL/api/telegram/webhook)
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 24+ characters [A-Za-z0-9_-]; also set the same value in the frontend .env (webhook check).
TELEGRAM_WEBHOOK_SECRET=
