# Keep the build context small and free of secrets.

# Secrets — never copied into an image.
.env
.env.*

# Dependencies and build output (rebuilt inside the image).
node_modules
dist
build
src/generated
*.tsbuildinfo

# Version control and CI.
.git
.gitignore
.gitlab-ci.yml

# Editor / OS noise.
.idea
.vscode
.DS_Store
Thumbs.db

# Test coverage output.
coverage

# Retention archives written in development (ARCHIVE_DIR). They hold records.
storage

# Logs and temp files.
logs
*.log
npm-debug.log*
.cache
.temp
.tmp

# Docker + tooling files not needed at build time.
Dockerfile
.dockerignore
docker-compose.yml
.prettierrc
.prettierignore
