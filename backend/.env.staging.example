# ─────────────────────────────────────────────────────────────────────────────
# Template for backend/.env.staging — copy it and fill in real values.
#
# Used by docker-compose.staging.yml on the staging host (next to the compose
# file, never committed), and by `npm run db:setup:staging` from any machine
# that can reach the database. Every deploy checks it with the release's own
# `config:check` before anything changes: errors stop the deploy.
#
# Secrets: generate fresh ones for staging (never reuse development values):
#   cd backend && npm run keys:generate
# SERVICE_CLIENTS and PAYLOAD_ENCRYPTION_KEYS must match frontend/.env.staging.
#
# Settings left out keep the defaults listed in .env.example.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
TRUST_PROXY=loopback
LOG_LEVEL=info
LOG_PRETTY=false

# Browser-facing address of the product (links in e-mails). HTTPS: sign-in
# needs it (see item 10 in docs/ci-cd-recommendations.md).
PUBLIC_APP_URL=https://CHANGE_ME
MAIL_FROM=NIB Digital Solutions <no-reply@nib.et>
# log until an SMTP relay is configured: e-mails are written to the log.
MAIL_TRANSPORT=log

# ── Database (PostgreSQL, external) ──────────────────────────────────────────
# Replace CHANGE_ME with the user, then add its password after the user name,
# separated by a colon. Kept out of the template so secret detection does not
# flag it. URL-encode special characters in the password ("@" is %40).
DATABASE_URL="postgresql://CHANGE_ME@172.24.0.54:5432/appcore?schema=public"

# ── Redis (the redis service in docker-compose.staging.yml) ─────────────────
KV_STORE=redis
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=appcore:

# ── Secrets (npm run keys:generate) ──────────────────────────────────────────
JWT_ACCESS_SECRET=__GENERATE__base64_48_bytes
MFA_SECRET_ENCRYPTION_KEY=__GENERATE__base64_32_bytes
# Dedicated key of the tamper-evident audit chain. Required in production.
# Never change it without an anchor checkpoint (README, audit trail).
AUDIT_CHAIN_KEY=__GENERATE__base64_32_bytes

# ── BFF service identity and payload encryption (match the frontend) ───────
# The browser-facing origin of the frontend; production requires a list.
CORS_ORIGINS=https://CHANGE_ME
SERVICE_AUTH_ENABLED=true
SERVICE_CLIENTS=appcore-web:__GENERATE__shared_secret
PAYLOAD_ENCRYPTION_MODE=required
PAYLOAD_ENCRYPTION_KEYS=k1:__GENERATE__base64_32_bytes
PAYLOAD_ENCRYPTION_ACTIVE_KEY_ID=k1

# ── Production posture ───────────────────────────────────────────────────────
# The API documentation stays off outside development.
SWAGGER_ENABLED=false
# Members of these roles are reminded until they enrol in two-step verification.
MFA_REQUIRED_ROLES=SUPER_ADMIN,ADMIN

# ── NIB Digital Solutions marketplace ────────────────────────────────────────
# Claude API key for the product assistant. Empty: on-device catalog assistant.
ANTHROPIC_API_KEY=
MARKETPLACE_ASSISTANT_MODEL=claude-opus-5-5
MARKETPLACE_MEDIA_MAX_BYTES=700000
