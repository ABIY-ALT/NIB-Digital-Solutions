# ─────────────────────────────────────────────────────────────────────────────
# Backend settings for the Windows server (no Docker).
# Guide: deploy/windows/README.md
#
#   1. Copy to backend\.env on the server (never commit the copy).
#   2. Replace every CHANGE_ME.
#   3. Run  node deploy\windows\fill-secrets.mjs  from the project folder: it
#      writes fresh secrets over every __GENERATE__ here and in
#      frontend\.env.production, with the shared values matching.
#
# Settings left out keep the defaults listed in .env.example.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
APP_NAME=digitalproducts-backend
PORT=4000
TRUST_PROXY=loopback
LOG_LEVEL=info
LOG_PRETTY=false

# Browser-facing HTTPS address of the site (links in e-mails). No trailing slash.
PUBLIC_APP_URL=https://digitalproductstest.nibbank.com.et
MAIL_FROM=NIB Digital Solutions <no-reply@nib.et>
# log  → e-mails are only written to the log (password-reset links included).
# smtp → sent through the bank's mail relay: set SMTP_HOST, SMTP_PORT, and
#        SMTP_USER / SMTP_PASSWORD if the relay needs them (see .env.example).
MAIL_TRANSPORT=log

# ── Database (the bank's PostgreSQL) ─────────────────────────────────────────
# Replace CHANGE_ME with  user:password  and CHANGE_ME_HOST with the server.
# URL-encode special characters in the password ("@" is %40, "#" is %23).
# The database "digitalproducts" is created on first setup if the user may
# create databases; otherwise ask the DBA to create it (empty) first.
DATABASE_URL="postgresql://CHANGE_ME@CHANGE_ME_HOST:5432/digitalproducts?schema=public"

# ── Redis (the bank's Redis server) ──────────────────────────────────────────
# With a password:  redis://:PASSWORD@host:6379/0   With TLS: rediss://...
# The key prefix keeps this product's keys apart from other apps on that Redis.
KV_STORE=redis
REDIS_URL=redis://CHANGE_ME_HOST:6379/0
REDIS_KEY_PREFIX=digitalproducts:

# ── Sign-in tokens ───────────────────────────────────────────────────────────
JWT_ISSUER=digitalproducts-backend
JWT_AUDIENCE=digitalproducts-bff
JWT_ACCESS_SECRET=__GENERATE__
MFA_SECRET_ENCRYPTION_KEY=__GENERATE__
# Key of the tamper-evident audit trail. Never change it once set.
AUDIT_CHAIN_KEY=__GENERATE__

# ── Frontend ⇄ backend (must match frontend\.env.production) ─────────────────
# The browser-facing address of the site; production requires it.
CORS_ORIGINS=https://digitalproductstest.nibbank.com.et
SERVICE_AUTH_ENABLED=true
SERVICE_CLIENTS=digitalproducts-web:__GENERATE__
PAYLOAD_ENCRYPTION_MODE=required
PAYLOAD_ENCRYPTION_KEYS=k1:__GENERATE__
PAYLOAD_ENCRYPTION_ACTIVE_KEY_ID=k1

# ── Production posture ───────────────────────────────────────────────────────
SWAGGER_ENABLED=false
MFA_REQUIRED_ROLES=SUPER_ADMIN,ADMIN

# ── Marketplace ──────────────────────────────────────────────────────────────
# Claude API key for the product assistant. Left commented out, the website
# uses its on-device catalog assistant. Uncomment only with a real key: an
# empty value stops the backend from starting.
# ANTHROPIC_API_KEY=
MARKETPLACE_ASSISTANT_MODEL=claude-opus-5-5
MARKETPLACE_MEDIA_MAX_BYTES=700000
MARKETPLACE_PRIVACY_SALT=__GENERATE__
# off: product questions are e-mailed to developers. For Telegram, see .env.example.
TELEGRAM_MODE=off
